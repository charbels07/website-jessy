---
layout: layouts/base.njk
navKey: parents
permalink: /for-parents/
---
{%- set pageLabel = navigation | navLabel(navKey) -%}
{%- set headerArt = "book" -%}
{% include "partials/page-header.njk" %}

<nav class="section section--first section--overview" aria-label="{{ pageLabel }}">
  <div class="container">
    {%- set linkBase = "" %}{% set listClass = "question-links--grid" %}
    {% include "partials/question-links.njk" %}
  </div>
</nav>

<div class="container entries">
  {%- for question in parents.questions %}
  <section class="entry" id="{{ question | itemId }}" aria-labelledby="{{ question | itemId }}-title">
    <div class="split">
      <div class="split__aside">
        <h2 class="entry__title" id="{{ question | itemId }}-title">{{ question.title | amp | safe }}</h2>
      </div>
      <div class="split__main prose prose--lead-first">{{ question.body | md | safe }}</div>
    </div>
  </section>
  {%- endfor %}
</div>
