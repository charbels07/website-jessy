---
layout: layouts/base.njk
navKey: areas
permalink: /areas-of-expertise/
toTop: true
---
{%- set pageLabel = navigation | navLabel(navKey) -%}
{%- set headerArt = "areas" -%}
{% include "partials/page-header.njk" %}

<nav class="section section--first section--overview" aria-label="{{ pageLabel }}">
  <div class="container">
    {%- set cardHeading = false %}{% set cardArrows = false %}
    {% include "partials/area-cards.njk" %}
  </div>
</nav>

<div class="container entries">
  {%- set areaIcons = ["blocks", "clipboard", "family", "steps", "school"] -%}
  {%- for area in areas.areas %}
  <section class="entry" id="{{ area | itemId }}" aria-labelledby="{{ area | itemId }}-title">
    <div class="split">
      <div class="split__aside">
        <div class="sticky">
          {%- set icon = area.icon or areaIcons[loop.index0 % 5] %}{% set iconClass = "entry__icon" %}
          {% include "partials/icon.njk" %}
          <h2 class="entry__title" id="{{ area | itemId }}-title">{{ area.title | amp | safe }}</h2>
        </div>
      </div>
      <div class="split__main doodles">
        <div class="prose prose--lead-first">{{ area.intro | md | safe }}</div>
        {%- for sub in area.subsections %}
        <div class="subsection">
          <h3 class="subsection__title">
            {%- if sub.icon %}{% set icon = sub.icon %}{% set iconClass = "subsection__icon" %}{% include "partials/icon.njk" %}{% endif -%}
            <span>{{ sub.title | amp | safe }}</span>
          </h3>
          <div class="prose">{{ sub.body | md | safe }}</div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endfor %}
</div>
