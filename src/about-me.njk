---
layout: layouts/base.njk
navKey: about
permalink: /about-me/
toTop: true
---
{%- set pageLabel = navigation | navLabel(navKey) -%}
{%- set hideHeaderArt = true -%}
{% include "partials/page-header.njk" %}

<section class="section section--first">
  <div class="container about-intro">
    <div class="about-intro__media{% if not (about.portrait and about.portrait.image) %} about-intro__media--scene scene-frame{% endif %}">
      {%- if about.portrait and about.portrait.image %}
      <figure class="portrait-frame">{% portrait about.portrait, "(min-width: 56em) 24rem, 72vw", "eager" %}</figure>
      {%- else %}
      {% scene "/assets/art/about-jessy.webp", "(min-width: 56em) 30rem, 92vw", "eager" %}
      {%- endif %}
    </div>
    <div class="about-intro__text prose prose--lead doodles">{{ about.intro | md | safe }}</div>
  </div>
</section>

<div class="container entries">
  {%- for section in about.sections %}
  <section class="entry" aria-labelledby="{{ section | itemId }}">
    <div class="split">
      <div class="split__aside">
        <h2 class="entry__title" id="{{ section | itemId }}">{{ section.title | amp | safe }}</h2>
        {%- if section.art %}
        <img class="aside-art" src="{{ ('/assets/illustrations/' ~ section.art ~ '.svg') | versioned }}" width="320" height="240" alt="" loading="lazy" decoding="async">
        {%- endif %}
      </div>
      <div class="split__main doodles">
        <div class="prose">{{ section.body | md | safe }}</div>
        {%- if loop.last and about.closing %}
        <div class="statement">
          {%- set icon = "heart" %}{% set iconClass = "statement__icon" %}
          {% include "partials/icon.njk" %}
          {{ about.closing | md | safe }}
        </div>
        {%- endif %}
      </div>
    </div>
  </section>
  {%- endfor %}
</div>
