---
layout: layouts/base.njk
title: Page not found
permalink: /404.html
eleventyExcludeFromCollections: true
---
{%- set pageLabel = title -%}
{%- set headerArt = "boat" -%}
{% include "partials/page-header.njk" %}

<section class="section section--first">
  <div class="container">
    <ul class="question-links" role="list">
      {%- for item in navigation %}
      <li><a href="{{ item.url }}"><span>{{ item.label }}</span>{% include "partials/go.njk" %}</a></li>
      {%- endfor %}
    </ul>
  </div>
</section>
