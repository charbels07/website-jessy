{#- Inner-page header. Set `headerArt` (an illustration file name, without .svg) before including. -#}
<header class="page-header">
  <div class="container page-header__inner">
    <h1 class="page-header__title">{{ pageLabel | amp | safe }}</h1>
  </div>
  {%- if headerArt %}
  <img class="page-header__art" src="/assets/illustrations/{{ headerArt }}.svg" width="320" height="240" alt="" decoding="async">
  {%- endif %}
</header>
