<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__latin">{{ settings.name }}</span>
      {%- if settings.name_arabic %}
      <span class="brand__arabic" lang="ar" dir="rtl" aria-hidden="true">{{ settings.name_arabic }}</span>
      {%- endif %}
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- for item in navigation %}
        <li><a href="{{ item.url }}"{% if item.key == "contact" %} class="site-nav__cta"{% endif %}{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
