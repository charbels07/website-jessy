{#- Links to each For Parents question. Set `linkBase` ("" on the For Parents page itself) and optionally `listClass`. -#}
{%- set questionIcons = ["wonder", "clipboard", "blocks", "steps", "laptop", "signpost"] -%}
<ul class="question-links {{ listClass }}" role="list">
  {%- for question in parents.questions %}
  <li>
    <a href="{{ linkBase }}#{{ question | itemId }}">
      {%- set icon = question.icon or questionIcons[loop.index0 % 6] %}{% set iconClass = "question-links__icon" %}
      {% include "partials/icon.njk" %}
      <span>{{ question.title | amp | safe }}</span>
      {%- include "partials/arrow.njk" %}
    </a>
  </li>
  {%- endfor %}
</ul>
